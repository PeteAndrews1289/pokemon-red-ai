+def _dialog_or_menu_active(state: dict) -> bool:
+    """Return True for any declared dialogue/menu signal in a state snapshot."""
+    game = state.get("game", {}) if isinstance(state, dict) else {}
+    dialogue = game.get("dialogue_detected", {})
+    if isinstance(dialogue, dict) and dialogue.get("has_dialogue"):
+        return True
+    # Do not consult the legacy Red ``game_state`` label here: its historical
+    # title/text addresses were not valid pokered symbols.  The structural
+    # dialogue flag, explicit menu flags, strict bootstrap bytes, and actual
+    # coordinate movement are the supported signals for this gate.
+    if any(game.get(key) for key in ("menu_open", "is_menu_open", "is_in_menu")):
+        return True
+    menu = game.get("menu")
+    return bool(isinstance(menu, dict) and menu.get("open"))
+
+
+def _read_opening_control_observation(state: dict | None = None) -> dict:
+    """Read the narrow, supported-ROM signals used by the opening referee.
+
+    Only derived booleans and already-public map/coordinate fields are returned;
+    arbitrary RAM bytes are never exposed to the planner.
+    """
+    if game_type != "red" or env is None or not getattr(env, "memory_reader", None):
+        return {"available": False, "bootstrap_ready": False}
+
+    try:
+        reader = env.memory_reader
+        state = state if state is not None else env.get_comprehensive_state()
+        game_started = bool(reader._read_u8(RED_GAME_STARTED_ADDRESS) & 0x01)
+        map_id = reader._read_u8(RED_CURRENT_MAP_ADDRESS)
+        x = reader._read_u8(RED_PLAYER_X_ADDRESS)
+        y = reader._read_u8(RED_PLAYER_Y_ADDRESS)
+        party_count = reader._read_u8(RED_PARTY_COUNT_ADDRESS)
+        battle_state = reader._read_u8(RED_BATTLE_STATE_ADDRESS)
+        input_unlocked = reader._read_u8(RED_JOY_IGNORE_ADDRESS) == 0
+        bedroom_script_ready = (
+            map_id == RED_BEDROOM_MAP_ID
+            and reader._read_u8(RED_HOUSE_2F_SCRIPT_ADDRESS) == RED_BEDROOM_NOOP_SCRIPT
+        )
+        interaction_clear = not _dialog_or_menu_active(state)
+        bootstrap_ready = (
+            game_started
+            and map_id == RED_BEDROOM_MAP_ID
+            and (x, y) == RED_BEDROOM_START
+            and party_count == 0
+            and battle_state == 0
+            and input_unlocked
+            and bedroom_script_ready
+            and interaction_clear
