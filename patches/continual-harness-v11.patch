+    assert result["success"] is True
+    assert result["raw_state"]["map"] == {}
+    assert formatted_states[0]["map"] == {}
+    assert environment.map_reader.calls == 0
+    # The shared emulator-cache object remains untouched.
+    assert original_state["map"] == {"red_whole_map": {"grid": ["future bedroom"]}}
+
+
+def test_pathfinder_refuses_future_bedroom_map_before_game_start(monkeypatch):
+    monkeypatch.setenv("GAME_TYPE", "red")
+    environment = _ToolEnvironment(_pregame_tool_state())
+
+    result = game_tools.navigate_to_direct(environment, 0, 2)
+
+    assert result["success"] is False
+    assert result["reason"] == "pregame"
+    assert "before Pokemon Red" in result["error"]
+    assert environment.map_reader.calls == 0
+
+
+def test_red_emulator_map_accessors_fail_closed_before_start():
+    map_reader = _CountingMapReader()
+    memory_reader = SimpleNamespace(
+        has_game_started=lambda: False,
+        map_reader=map_reader,
+        read_map_around_player=lambda _radius: (_ for _ in ()).throw(
+            AssertionError("pregame tile reader must not be called")
+        ),
+    )
+    emulator = object.__new__(RedEmulator)
+    emulator.memory_reader = memory_reader
+
+    assert emulator.get_map_tiles() == []
+    assert emulator.get_whole_map() == {}
+    assert map_reader.calls == 0
+
+
+def test_formatter_hides_hostile_future_world_state():
+    hostile_state = {
+        "player": {
+            "name": "RED",
+            "location": "RedsHouse2f",
+            "position": {"x": 3, "y": 6},
+            "party": [],
+        },
+        "game": {
+            "game_started": False,
+            "game_state": "overworld",
+            "is_in_battle": True,
+            "money": 3000,
+            "party": [],
+            "items": [],
+        },
+        "map": {
+            "visual_map": "FUTURE_BEDROOM_MAP",
+            "red_whole_map": {"grid": ["FUTURE_BEDROOM_MAP"]},
+        },
+    }
+
+    text = format_state_for_llm(hostile_state)
+
+    assert "FUTURE_BEDROOM_MAP" not in text
+    assert "RedsHouse2f" not in text
+    assert "Position: X=3" not in text
+    assert "Money: $3000" not in text
+    assert "BATTLE MODE" not in text
+    assert "Gameplay fields unavailable" in text
+
+
+def test_map_endpoints_reject_pregame_without_reading_map(monkeypatch):
+    monkeypatch.setenv("GAME_TYPE", "red")
+    monkeypatch.setattr(server_app, "game_type", "red")
+    environment = _ToolEnvironment(_pregame_tool_state())
+    monkeypatch.setattr(server_app, "env", environment)
+    monkeypatch.setattr(server_app, "current_obs", None)
+    monkeypatch.setattr(server_app, "recent_button_presses", [])
+
+    structured = asyncio.run(server_app.mcp_get_map_data())
+    assert structured["success"] is False
+    assert structured["reason"] == "pregame"
+
+    with pytest.raises(server_app.HTTPException) as exc_info:
+        asyncio.run(server_app.get_whole_map())
+    assert exc_info.value.status_code == 409
+    assert environment.map_reader.calls == 0
+
+
+def test_dashboard_state_cannot_restore_cached_pregame_map(monkeypatch):
+    monkeypatch.setattr(server_app, "game_type", "red")
+    original_state = _pregame_tool_state()
+    environment = _ToolEnvironment(original_state)
+    monkeypatch.setattr(server_app, "env", environment)
+    monkeypatch.setattr(server_app, "action_queue", [])
+    monkeypatch.setattr(
+        server_app,
+        "_state_cache",
+        {
+            "location": None,
+            "player_coords": None,
+            "map_data": {"red_whole_map": {"grid": ["stale future bedroom"]}},
+            "portal_data": None,
+            "timestamp": server_app.time.time(),
+        },
+    )
+
+    response = asyncio.run(server_app.get_comprehensive_state())
+
+    assert response.game["game_state"] == "pregame"
+    assert response.map == {}
+    assert environment.map_reader.calls == 0
+    assert original_state["map"] == {"red_whole_map": {"grid": ["future bedroom"]}}
+    assert server_app._state_cache["map_data"] is None
