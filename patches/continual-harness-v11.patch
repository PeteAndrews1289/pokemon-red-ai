@@ -0,0 +1,126 @@
+"""Tests for the opt-in expert tool surface used by assisted CLI runs."""
+
+from __future__ import annotations
+
+import asyncio
+import importlib
+import sys
+
+
+MODULE = "server.cli.pokemon_mcp_server"
+
+CORE_TOOLS = {"get_game_state", "press_buttons"}
+EXPERT_TOOLS = {
+    "navigate_to",
+    "process_memory",
+    "add_memory",
+    "search_memory",
+    "get_memory_summary",
+    "get_memory_overview",
+    "complete_direct_objective",
+    "get_progress_summary",
+    "replan_objectives",
+    "reflect",
+}
+
+
+def _load_proxy(monkeypatch, *, expert: bool):
+    monkeypatch.setenv("GAME_TYPE", "red")
+    if expert:
+        monkeypatch.setenv("POKEAGENT_CLI_EXPERT", "1")
+    else:
+        monkeypatch.delenv("POKEAGENT_CLI_EXPERT", raising=False)
+    sys.modules.pop(MODULE, None)
+    return importlib.import_module(MODULE)
+
+
+def _tool_names(proxy) -> set[str]:
+    return {tool.name for tool in asyncio.run(proxy.mcp.list_tools())}
+
+
+def test_default_surface_remains_two_tools(monkeypatch):
+    proxy = _load_proxy(monkeypatch, expert=False)
+
+    assert proxy.EXPERT_MODE is False
+    assert proxy.mcp.name == "pokemon-red"
+    assert _tool_names(proxy) == CORE_TOOLS
+
+
+def test_expert_surface_is_explicit_and_complete(monkeypatch):
+    proxy = _load_proxy(monkeypatch, expert=True)
+
+    assert proxy.EXPERT_MODE is True
+    assert _tool_names(proxy) == CORE_TOOLS | EXPERT_TOOLS
+
+
+def test_red_button_description_does_not_offer_shoulders(monkeypatch):
+    proxy = _load_proxy(monkeypatch, expert=True)
+    press_tool = next(
+        tool for tool in asyncio.run(proxy.mcp.list_tools()) if tool.name == "press_buttons"
+    )
+
+    assert "Pokemon Red supports" in press_tool.description
+    assert "Emerald additionally supports L and R" in press_tool.description
+
+
+def test_expert_tools_forward_auditable_payloads(monkeypatch):
+    proxy = _load_proxy(monkeypatch, expert=True)
+    calls = []
+
+    def fake_post(path, body=None, timeout=proxy._TIMEOUT_MEDIUM):
+        calls.append((path, body, timeout))
+        return {"success": True}
+
+    monkeypatch.setattr(proxy, "_post", fake_post)
+
+    proxy.navigate_to(7, 12, variance="high", reason="Reach the Route 1 exit")
+    proxy.complete_direct_objective(
+        "Location now reads Route 1 and player is outside Pallet Town",
+        category="story",
+    )
+    proxy.process_memory(
+        "add",
+        [{"path": "navigation/pallet", "title": "North exit", "content": "Use x=10"}],
+        "Record a route that was just verified",
+    )
+
+    assert calls[0][0:2] == (
+        "/mcp/navigate_to",
+        {"x": 7, "y": 12, "reason": "Reach the Route 1 exit", "variance": "high"},
+    )
+    assert calls[1][0] == "/mcp/complete_direct_objective"
+    assert calls[1][1]["category"] == "story"
+    assert "Route 1" in calls[1][1]["completion_notes"]
+    assert calls[2][0] == "/mcp/process_memory"
+    assert calls[2][1]["action"] == "add"
+
+
+def test_reflect_is_read_only_and_removes_raw_state(monkeypatch):
+    proxy = _load_proxy(monkeypatch, expert=True)
+
+    def fake_post(path, body=None, timeout=proxy._TIMEOUT_MEDIUM):
+        if path == "/mcp/get_game_state":
+            return {
+                "success": True,
+                "location": "Pallet Town",
+                "screenshot_base64": "sensitive-large-payload",
+                "raw_state": {"ram": "not-for-reflection"},
+            }
+        if path == "/mcp/get_progress_summary":
+            return {"success": True, "progress": {"milestones_completed": []}}
+        raise AssertionError(f"unexpected POST {path}")
+
+    monkeypatch.setattr(proxy, "_post", fake_post)
+    monkeypatch.setattr(
+        proxy,
+        "_get",
+        lambda path, timeout=proxy._TIMEOUT_SHORT: {"recent_buttons": ["UP"]},
+    )
+
+    result = proxy.reflect("Repeated movement did not change position")
+
+    assert result["success"] is True
+    assert result["current_state"]["location"] == "Pallet Town"
+    assert "screenshot_base64" not in result["current_state"]
+    assert "raw_state" not in result["current_state"]
+    assert result["recent_actions"] == {"recent_buttons": ["UP"]}
