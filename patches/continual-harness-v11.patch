+        )
+        self.milestone_tracker = None
+        self._cached_dialog_state = False
+
+    def get_comprehensive_state(self, screenshot=None):
+        return self.state
+
+
+def _pregame_tool_state():
+    return {
+        "visual": {},
+        "player": {"location": None, "position": None},
+        "game": {"game_started": False, "game_state": "pregame"},
+        "map": {"red_whole_map": {"grid": ["future bedroom"]}},
+    }
+
+
+def test_planner_state_copies_cache_and_suppresses_pregame_map(monkeypatch):
+    monkeypatch.setenv("GAME_TYPE", "red")
+    original_state = _pregame_tool_state()
+    environment = _ToolEnvironment(original_state)
+    formatted_states = []
+
+    def formatter(state, action_history=None):
+        formatted_states.append(state)
+        return "Game State: pregame"
+
+    result = game_tools.get_game_state_direct(environment, formatter)
