+"""No-ROM regressions for Pokemon Red's pre-game and message-box truth signals."""
+
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from pokemon_red_env.red_emulator import RedEmulator
+from pokemon_red_env.red_memory_reader import RED_ADDR, RedMemoryReader
+from server import app as server_app
+from server import game_tools
+from utils.state_formatter import format_state_for_llm
+
+
+class _FakePyBoy:
+    def __init__(self):
+        self.memory = bytearray(0x10000)
+
+
+def _reader() -> RedMemoryReader:
+    return RedMemoryReader(_FakePyBoy())
+
+
+def _draw_message_box(reader: RedMemoryReader) -> None:
+    memory = reader.pyboy.memory
+    base = RED_ADDR["vram_tilemap"]
+    top = [0x79, *([0x7A] * 18), 0x7B]
+    bottom = [0x7D, *([0x7A] * 18), 0x7E]
+    memory[base + 12 * 20:base + 13 * 20] = bytes(top)
+    for row in range(13, 17):
+        memory[base + row * 20] = 0x7C
+        memory[base + row * 20 + 19] = 0x7C
+    memory[base + 17 * 20:base + 18 * 20] = bytes(bottom)
+
+
+def test_exact_message_box_is_detected_even_when_text_extraction_is_disabled():
+    reader = _reader()
+    _draw_message_box(reader)
+    reader._dialog_detection_enabled = False
+
+    state = reader.get_comprehensive_state()
+
+    assert reader.is_in_dialog() is True
+    assert reader.get_game_state() == "dialog"
+    assert state["game"]["dialogue_detected"]["has_dialogue"] is True
+    assert state["game"]["dialog_text"] is None
+
+
+def test_space_tiles_cannot_masquerade_as_a_message_box():
+    reader = _reader()
+    base = RED_ADDR["vram_tilemap"]
+    reader.pyboy.memory[base + 12 * 20:base + 18 * 20] = bytes([0x7F] * 120)
+
+    assert reader.is_in_dialog() is False
+
+
+def test_pregame_masks_initialized_bedroom_scratch_state():
+    reader = _reader()
+    memory = reader.pyboy.memory
+    memory[RED_ADDR["map_id"]] = 0x26
+    memory[RED_ADDR["player_x"]] = 3
+    memory[RED_ADDR["player_y"]] = 6
+    memory[RED_ADDR["party_count"]] = 4
+    memory[RED_ADDR["money"]:RED_ADDR["money"] + 3] = b"\x00\x30\x00"
+
+    state = reader.get_comprehensive_state()
+
+    assert reader.has_game_started() is False
+    assert state["game"]["game_state"] == "pregame"
+    assert state["game"]["game_started"] is False
+    assert state["player"]["position"] is None
+    assert state["player"]["location"] is None
+    assert state["player"]["name"] is None
+    assert state["player"]["party"] == []
+    assert state["game"]["money"] is None
+    assert state["game"]["items"] == []
+
+
+def test_pregame_battle_scratch_byte_cannot_override_truth():
+    reader = _reader()
+    reader.pyboy.memory[RED_ADDR["in_battle"]] = 0xFF
+
+    state = reader.get_comprehensive_state()
+
+    assert reader.is_in_battle() is False
+    assert reader.get_game_state() == "pregame"
+    assert state["game"]["is_in_battle"] is False
+
+
+def test_started_game_exposes_real_bedroom_state():
+    reader = _reader()
+    memory = reader.pyboy.memory
+    memory[RED_ADDR["status_flags_6"]] = 0x01
+    memory[RED_ADDR["map_id"]] = 0x26
+    memory[RED_ADDR["player_x"]] = 3
+    memory[RED_ADDR["player_y"]] = 6
+
+    state = reader.get_comprehensive_state()
+
+    assert reader.has_game_started() is True
+    assert state["game"]["game_state"] == "overworld"
+    assert state["game"]["game_started"] is True
+    assert state["player"]["position"] == {"x": 3, "y": 6}
+    assert state["player"]["location"] == "RedsHouse2f"
+
+
+def test_game_running_milestone_requires_the_documented_started_bit():
+    from pokemon_red_env.red_emulator import RedEmulator
+
+    emulator = object.__new__(RedEmulator)
+    emulator.memory_reader = _reader()
+    emulator.milestone_tracker = SimpleNamespace(is_completed=lambda _name: False)
+
+    assert emulator._check_red_milestone("GAME_RUNNING", {}) is False
+    emulator.memory_reader.pyboy.memory[RED_ADDR["status_flags_6"]] = 0x01
+    assert emulator._check_red_milestone("GAME_RUNNING", {}) is True
+
+
+def test_world_map_gate_requires_started_bit_and_observable_player(monkeypatch):
+    monkeypatch.setattr(server_app, "game_type", "red")
+    state = {
+        "game": {"game_started": False},
+        "player": {"location": None, "position": None},
+    }
+
+    assert server_app._red_world_state_is_observable(state) is False
+
+    state["game"]["game_started"] = True
+    state["player"] = {
+        "location": "RedsHouse2f",
+        "position": {"x": 3, "y": 6},
+    }
+    assert server_app._red_world_state_is_observable(state) is True
+
+
+class _CountingMapReader:
+    def __init__(self):
+        self.calls = 0
+
+    def get_whole_map_data(self):
+        self.calls += 1
+        return {"grid": ["future bedroom"]}
+
+
+class _ToolEnvironment:
+    current_frame = None
+
+    def __init__(self, state):
+        self.state = state
+        self.map_reader = _CountingMapReader()
+        self.memory_reader = SimpleNamespace(
+            map_reader=self.map_reader,
