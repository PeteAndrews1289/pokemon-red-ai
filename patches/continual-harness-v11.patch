+def _movement_proves_player_control(button: str, before: dict, after: dict) -> bool:
+    """Require an input-ready bedroom start followed by real map movement."""
+    if str(button).upper() not in _DIRECTIONAL_BUTTONS:
+        return False
+    if not before.get("bootstrap_ready") or not after.get("available"):
+        return False
+    if not after.get("game_started") or after.get("map_id") != RED_BEDROOM_MAP_ID:
+        return False
+    if after.get("battle_state") != 0:
+        return False
+    before_coords = before.get("coordinates") or {}
+    after_coords = after.get("coordinates") or {}
+    before_xy = (before_coords.get("x"), before_coords.get("y"))
+    after_xy = (after_coords.get("x"), after_coords.get("y"))
