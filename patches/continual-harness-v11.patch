+"""Fail-closed tests for the Pokemon Red opening-sequence referee."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from types import SimpleNamespace
+
+from server import app as server_app
+from server import game_tools
+
+
+class _MemoryReader:
+    def __init__(self, values=None):
+        self.values = values or {}
+
+    def _read_u8(self, address):
+        return self.values.get(address, 0)
+
+
+class _Environment:
+    def __init__(self, reader, state=None):
+        self.memory_reader = reader
+        self.state = state or {
+            "game": {
+                "game_state": "overworld",
+                "dialogue_detected": {"has_dialogue": False},
+            }
+        }
+
+    def get_comprehensive_state(self):
+        return self.state
+
+
+def _ready_memory_values(*, game_started=True, x=3, y=6):
+    return {
+        server_app.RED_GAME_STARTED_ADDRESS: int(game_started),
+        server_app.RED_CURRENT_MAP_ADDRESS: server_app.RED_BEDROOM_MAP_ID,
+        server_app.RED_PLAYER_X_ADDRESS: x,
+        server_app.RED_PLAYER_Y_ADDRESS: y,
+        server_app.RED_PARTY_COUNT_ADDRESS: 0,
+        server_app.RED_BATTLE_STATE_ADDRESS: 0,
+        server_app.RED_JOY_IGNORE_ADDRESS: 0,
+        server_app.RED_HOUSE_2F_SCRIPT_ADDRESS: server_app.RED_BEDROOM_NOOP_SCRIPT,
+    }
+
+
+def _observation(*, x=3, y=6, ready=True, interaction_clear=True):
+    return {
+        "available": True,
+        "game_started": True,
+        "map_id": server_app.RED_BEDROOM_MAP_ID,
+        "coordinates": {"x": x, "y": y},
+        "party_count": 0,
+        "battle_state": 0,
+        "input_unlocked": True,
+        "bedroom_script_ready": True,
+        "interaction_clear": interaction_clear,
+        "bootstrap_ready": ready,
+    }
+
+
+def test_initialized_bedroom_scratch_ram_is_not_input_ready(monkeypatch):
+    values = _ready_memory_values(game_started=False)
+    monkeypatch.setattr(server_app, "game_type", "red")
+    monkeypatch.setattr(server_app, "env", _Environment(_MemoryReader(values)))
+
+    observation = server_app._read_opening_control_observation()
+
+    assert observation["map_id"] == server_app.RED_BEDROOM_MAP_ID
+    assert observation["coordinates"] == {"x": 3, "y": 6}
+    assert observation["game_started"] is False
+    assert observation["bootstrap_ready"] is False
+
+
+def test_supported_rom_input_ready_tuple_is_strict(monkeypatch):
+    values = _ready_memory_values()
+    reader = _MemoryReader(values)
+    monkeypatch.setattr(server_app, "game_type", "red")
+    monkeypatch.setattr(server_app, "env", _Environment(reader))
+
+    assert server_app._read_opening_control_observation()["bootstrap_ready"] is True
+
+    for address, locked_value in (
+        (server_app.RED_JOY_IGNORE_ADDRESS, 1),
+        (server_app.RED_HOUSE_2F_SCRIPT_ADDRESS, 0),
+        (server_app.RED_PARTY_COUNT_ADDRESS, 1),
+        (server_app.RED_BATTLE_STATE_ADDRESS, 1),
+    ):
+        original = reader.values[address]
+        reader.values[address] = locked_value
+        assert server_app._read_opening_control_observation()["bootstrap_ready"] is False
+        reader.values[address] = original
+
+
+def test_only_real_directional_bedroom_movement_proves_control():
+    before = _observation()
+    moved = _observation(y=7)
+
+    assert server_app._movement_proves_player_control("DOWN", before, moved) is True
+    assert server_app._movement_proves_player_control("A", before, moved) is False
+    assert server_app._movement_proves_player_control("DOWN", before, before) is False
+    assert server_app._movement_proves_player_control(
+        "DOWN", _observation(ready=False), moved
+    ) is False
+    # The post-action sample may still show a transient walking input lock; the
+    # strict input-ready proof is intentionally taken before the action.
+    assert server_app._movement_proves_player_control(
+        "DOWN", before, _observation(y=7, interaction_clear=False)
+    ) is True
+
+
+def test_player_control_latch_is_one_way_and_persisted(monkeypatch):
+    persisted = []
+    monkeypatch.setattr(server_app, "player_control_verified", False)
+    monkeypatch.setattr(server_app, "player_control_evidence", None)
+    monkeypatch.setattr(
+        server_app,
+        "_persist_opening_referee",
+        lambda: persisted.append(True),
+    )
+
+    assert server_app._record_player_control_if_proven(
+        "DOWN", _observation(), _observation(y=7)
+    ) is True
+    assert server_app.player_control_verified is True
+    assert server_app.player_control_evidence["start"] == {"x": 3, "y": 6}
+    assert server_app.player_control_evidence["end"] == {"x": 3, "y": 7}
+    assert persisted == [True]
+
+    # Later observations cannot replace the original empirical evidence.
+    original = dict(server_app.player_control_evidence)
+    assert server_app._record_player_control_if_proven(
+        "UP", _observation(), _observation(y=5)
+    ) is False
+    assert server_app.player_control_evidence == original
+    assert persisted == [True]
+
+
+def test_opening_latch_round_trips_in_run_scoped_cache(tmp_path, monkeypatch):
+    path = tmp_path / "opening_referee.json"
+    monkeypatch.setattr(server_app, "_opening_referee_cache_path", lambda: path)
+    monkeypatch.setattr(server_app, "game_type", "red")
+    monkeypatch.setattr(
+        server_app,
+        "env",
+        _Environment(_MemoryReader(_ready_memory_values())),
+    )
+    monkeypatch.setattr(server_app, "player_control_verified", True)
+    monkeypatch.setattr(
+        server_app,
+        "player_control_evidence",
+        {
+            "button": "DOWN",
+            "map_id": server_app.RED_BEDROOM_MAP_ID,
+            "start": {"x": 3, "y": 6},
+            "end": {"x": 3, "y": 7},
+        },
+    )
+
+    server_app._persist_opening_referee()
+    monkeypatch.setattr(server_app, "player_control_verified", False)
+    monkeypatch.setattr(server_app, "player_control_evidence", None)
+    server_app._initialize_opening_referee()
+
+    assert server_app.player_control_verified is True
+    assert server_app.player_control_evidence["button"] == "DOWN"
+
+    path.write_text(
+        json.dumps({"player_control_verified": True, "evidence": {"button": "DOWN"}}),
+        encoding="utf-8",
+    )
+    server_app._initialize_opening_referee()
+    assert server_app.player_control_verified is False
+    assert server_app.player_control_evidence is None
+
+
+def test_return_to_pregame_invalidates_persisted_control_proof(monkeypatch):
+    monkeypatch.setattr(server_app, "game_type", "red")
+    monkeypatch.setattr(
+        server_app,
+        "env",
+        _Environment(_MemoryReader(_ready_memory_values(game_started=False))),
+    )
+    monkeypatch.setattr(server_app, "player_control_verified", True)
