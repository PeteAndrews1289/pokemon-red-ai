+        server_app,
+        "player_control_evidence",
+        {
+            "button": "DOWN",
+            "map_id": server_app.RED_BEDROOM_MAP_ID,
+            "start": {"x": 3, "y": 6},
+            "end": {"x": 3, "y": 7},
+        },
+    )
+
+    assert server_app._opening_referee_snapshot()["player_control_verified"] is False
+    assert server_app.player_control_evidence is None
+    assert server_app._opening_objective_completion_error("pallet_000") is not None
+
+
+def test_pallet_objective_rejected_before_any_manager_mutation(monkeypatch):
+    class _Manager:
+        mode = "categorized"
+        sequence_name = "categorized_full_game"
+
+        def __init__(self):
+            self.marked = False
+
