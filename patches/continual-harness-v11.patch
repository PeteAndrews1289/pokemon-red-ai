+RED_CURRENT_MAP_ADDRESS = 0xD35E  # wCurMap
+RED_PLAYER_Y_ADDRESS = 0xD361  # wYCoord
+RED_PLAYER_X_ADDRESS = 0xD362  # wXCoord
+RED_PARTY_COUNT_ADDRESS = 0xD163  # wPartyCount
+RED_BATTLE_STATE_ADDRESS = 0xD057  # wIsInBattle
+RED_JOY_IGNORE_ADDRESS = 0xCD6B  # wJoyIgnore
+RED_HOUSE_2F_SCRIPT_ADDRESS = 0xD60C  # wRedsHouse2FCurScript
+RED_BEDROOM_MAP_ID = 0x26
