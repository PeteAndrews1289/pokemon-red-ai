+def _clean_args(**overrides):
+    values = {
+        "local_agent": True,
+        "expert_mode": True,
+        "load_state": None,
+        "load_checkpoint": False,
+        "backup_state": None,
+        "direct_objectives_start": 0,
+    }
+    values.update(overrides)
+    return SimpleNamespace(**values)
+
+
+def test_termination_exit_codes_do_not_report_failed_canaries_as_success():
+    assert run_cli._termination_exit_code("termination_condition_met") == 0
+    for reason in (
+        "user_interrupt",
+        "consecutive_failures",
+        "server_died",
+        "auth_error",
+        "mcp_connection_failure",
+        "unexpected_reason",
+        None,
+    ):
+        assert run_cli._termination_exit_code(reason) == 1
+
