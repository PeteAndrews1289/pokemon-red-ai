+def _write_cache_zip(
+    cache_path: Path,
+    backup_zip: Path,
+    *,
+    lightweight: bool = False,
+) -> list[str]:
+    """Archive safe cache files without following links or CODEX_HOME data."""
+    skipped: list[str] = []
+
+    def on_walk_error(err: OSError):
+        skipped.append(str(err.filename))
+
+    with zipfile.ZipFile(backup_zip, "w", zipfile.ZIP_DEFLATED) as zf:
+        for root, dirs, files in os.walk(
+            cache_path,
+            topdown=True,
+            followlinks=False,
+            onerror=on_walk_error,
+        ):
+            root_path = Path(root)
+            safe_dirs = []
+            for dirname in dirs:
+                directory = root_path / dirname
+                if directory.is_symlink() or _private_backup_directory(directory):
+                    skipped.append(str(directory))
+                elif lightweight:
+                    # Objective-time backups are intentionally metadata-only.
+                    skipped.append(str(directory))
+                else:
+                    safe_dirs.append(dirname)
+            dirs[:] = safe_dirs
+
+            for name in files:
+                filepath = root_path / name
+                relative = filepath.relative_to(cache_path)
+                if (
+                    filepath.is_symlink()
+                    or name.casefold() in _PRIVATE_BACKUP_FILENAMES
+                    or any(_private_backup_directory(cache_path / part) for part in relative.parts[:-1])
