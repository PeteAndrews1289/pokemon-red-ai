+                ):
+                    skipped.append(str(filepath))
+                    continue
+
+                arcname = cache_path.name / relative
+                try:
+                    zf.write(filepath, arcname)
+                except (PermissionError, OSError) as exc:
+                    skipped.append(str(filepath))
+                    logger.debug("Skipped %s: %s", arcname, exc)
+
+    return skipped
+
+
