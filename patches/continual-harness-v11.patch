+    def _read_u8(self, address):
+        return self.memory.get(address, 0)
+
+
+class _FakeMapReader:
+    def __init__(self, _pyboy):
+        pass
+
+
+class _FakeMilestoneTracker:
+    def is_completed(self, _milestone_id):
+        return False
+
+
+class _FakePyBoy:
+    instances = []
+
+    def __init__(self, _rom_path, *, window, sound):
+        self.window = window
+        self.sound = sound
+        self.loaded_states = []
+        self.__class__.instances.append(self)
+
+    def load_state(self, source):
+        self.loaded_states.append(source.read())
+
+
+def _install_fake_emulator_dependencies(monkeypatch):
+    fake_pyboy_module = types.ModuleType("pyboy")
+    fake_pyboy_module.PyBoy = _FakePyBoy
+    monkeypatch.setitem(sys.modules, "pyboy", fake_pyboy_module)
+    monkeypatch.setattr(red_emulator, "RedMemoryReader", _FakeMemoryReader)
+    monkeypatch.setattr(red_emulator, "RedMapReader", _FakeMapReader)
+    _FakePyBoy.instances.clear()
+
+
+def test_adjacent_state_requires_explicit_opt_in(tmp_path, monkeypatch):
+    _install_fake_emulator_dependencies(monkeypatch)
+    monkeypatch.setattr(
+        RedEmulator,
+        "_get_cache_dir",
+        staticmethod(lambda: str(tmp_path / "cache")),
+    )
+
+    rom_path = tmp_path / "pokered.gbc"
+    rom_path.write_bytes(b"rom")
+    adjacent_state = tmp_path / "pokered.gbc.state"
+    adjacent_state.write_bytes(b"development-state")
+
+    clean = RedEmulator(str(rom_path))
+    clean.initialize()
+    assert _FakePyBoy.instances[-1].loaded_states == []
+
+    opted_in = RedEmulator(str(rom_path), auto_load_adjacent_state=True)
+    opted_in.initialize()
+    assert _FakePyBoy.instances[-1].loaded_states == [b"development-state"]
