+from unittest.mock import patch
+
+import run_cli
+from server import app as server_app
+from utils.agent_infrastructure.cli_agent_backends import (
+    CodexCliBackend,
+    CliSessionMetrics,
+    validate_agent_model_slug,
+)
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+
+
+class LocalCodexModeTests(unittest.TestCase):
+    def test_local_auth_is_linked_not_copied(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            host_codex = root / "host-codex"
+            run_codex = root / "run-codex"
+            host_codex.mkdir()
+            run_codex.mkdir()
+            source = host_codex / "auth.json"
+            source.write_text("test credential placeholder", encoding="utf-8")
+
+            self.assertTrue(run_cli._seed_local_codex_auth(run_codex, host_codex))
+            destination = run_codex / "auth.json"
+            self.assertTrue(destination.is_symlink())
+            self.assertEqual(destination.resolve(), source.resolve())
+
+    def test_local_launch_is_sandboxed_and_docker_free(self):
+        with tempfile.TemporaryDirectory() as tmp, patch.dict(
+            os.environ,
+            {
+                "POKEAGENT_CLI_EXPERT": "1",
+                "UNRELATED_API_KEY": "must-not-reach-agent",
+                "UNRELATED_TOKEN": "must-not-reach-agent",
+                "OPENAI_API_KEY": "must-not-reach-agent",
+                "GITHUB_TOKEN": "must-not-reach-agent",
+                "GAME_TYPE": "emerald",
+            },
+            clear=False,
+        ):
+            root = Path(tmp)
+            scratch = root / "scratch"
+            memory = root / "codex-home"
+            backend = CodexCliBackend()
+            backend.api_gateway = "login"
+
+            cmd, env, _, _ = backend.build_launch_cmd(
+                str(REPO_ROOT / "agents/prompts/cli-agent-directives/pokemon_directive.md"),
