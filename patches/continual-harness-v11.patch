+def test_clean_start_scrubs_inherited_restore_environment(monkeypatch):
+    for name in (
+        "LOAD_STATE",
+        "LOAD_CHECKPOINT_MODE",
+        "RUN_DATA_ID",
+        "BACKUP_STATE",
+        "CHECKPOINT_STATE",
+    ):
+        monkeypatch.setenv(name, "hostile-inherited-value")
+
+    run_cli._prepare_clean_expert_start(_clean_args())
+
+    assert "RUN_DATA_ID" not in os.environ
+    assert os.environ["LOAD_STATE"] == ""
+    assert os.environ["BACKUP_STATE"] == ""
+    assert os.environ["CHECKPOINT_STATE"] == ""
+    assert os.environ["LOAD_CHECKPOINT_MODE"] == "false"
+
+
+def test_clean_start_rejects_explicit_restore_flags():
+    for args in (
+        _clean_args(load_state="old.state"),
+        _clean_args(load_checkpoint=True),
+        _clean_args(backup_state="old.zip"),
+    ):
+        try:
+            run_cli._prepare_clean_expert_start(args)
+        except ValueError as exc:
+            assert "clean power-on" in str(exc)
+        else:
+            raise AssertionError("restore flag was accepted")
+
