+            rendered = " ".join(cmd)
+            self.assertNotIn("docker", rendered)
+            self.assertNotIn("dangerously-bypass", rendered)
+            self.assertIn("--sandbox workspace-write", rendered)
+            self.assertIn("--model gpt-5.6-terra", rendered)
+            self.assertEqual(env["CODEX_HOME"], str(memory.resolve()))
+            self.assertEqual(env["POKEAGENT_REQUESTED_MODEL"], "gpt-5.6-terra")
+            self.assertNotIn("POKEAGENT_CONTROL_TOKEN", env)
