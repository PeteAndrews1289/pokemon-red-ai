+
+    def test_relative_working_directory_is_canonicalized_before_codex_launch(self):
+        """Codex must not resolve ``-C`` again from inside its process CWD."""
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            relative_scratch = Path("runs/canary/agent_scratch_space")
+            expected_scratch = (root / relative_scratch).resolve()
+            fake_bin = root / "bin"
+            fake_bin.mkdir()
+            fake_codex = fake_bin / "codex"
+            fake_codex.write_text(
+                """#!/bin/sh
+while [ "$#" -gt 0 ]; do
+    if [ "$1" = "-C" ]; then
+        shift
+        if [ ! -d "$1" ]; then
+            printf 'missing working directory: %s\\n' "$1" >&2
+            exit 42
+        fi
+        printf '%s\\n' "$1"
+        exit 0
+    fi
+    shift
+done
+printf '%s\\n' 'missing -C argument' >&2
+exit 43
+""",
+                encoding="utf-8",
+            )
+            fake_codex.chmod(0o755)
+
+            previous_cwd = Path.cwd()
+            try:
+                os.chdir(root)
+                backend = CodexCliBackend()
+                backend.api_gateway = "login"
+                cmd, env, _, _ = backend.build_launch_cmd(
+                    str(
+                        REPO_ROOT
+                        / "agents/prompts/cli-agent-directives/pokemon_expert_directive.md"
+                    ),
+                    "http://127.0.0.1:9999",
+                    str(relative_scratch),
+                    project_root=str(REPO_ROOT),
+                    containerized=False,
+                    agent_memory_dir=str(root / "codex-home"),
+                    thinking_effort="medium",
+                    agent_model="gpt-5.6-terra",
+                )
+                env["PATH"] = f"{fake_bin}{os.pathsep}{env['PATH']}"
+                completed = subprocess.run(
+                    cmd,
+                    cwd=str(relative_scratch),
+                    env=env,
+                    check=False,
+                    capture_output=True,
+                    text=True,
+                )
+            finally:
+                os.chdir(previous_cwd)
+
+            self.assertEqual(completed.returncode, 0, completed.stderr)
+            self.assertEqual(completed.stdout.strip(), str(expected_scratch))
+
+    def test_launcher_passes_one_canonical_working_directory_everywhere(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root = Path(tmp)
+            relative_scratch = Path("run_data/canary/agent_scratch_space")
+            expected_scratch = (root / relative_scratch).resolve()
+            expected_scratch.mkdir(parents=True)
+            captured = {}
+
+            class FakeInput:
+                def close(self):
+                    return None
+
+            class FakeProcess:
+                pid = 12345
+                stdin = FakeInput()
+                stdout = object()
+
+            class FakeBackend:
+                name = "FakeCodex"
+
+                def build_launch_cmd(
+                    self,
+                    directive_path,
+                    server_url,
+                    working_dir,
+                    **kwargs,
+                ):
+                    captured["backend_working_dir"] = working_dir
+                    return (["fake-codex"], {"PATH": os.environ["PATH"]}, "", None)
+
+                def run_stream_reader(self, *args, **kwargs):
+                    return None
+
+            def fake_popen(command, **kwargs):
+                captured["popen_working_dir"] = kwargs["cwd"]
+                return FakeProcess()
+
+            previous_cwd = Path.cwd()
+            try:
+                os.chdir(root)
+                with patch.object(run_cli.subprocess, "Popen", side_effect=fake_popen):
+                    session = run_cli.launch_cli_agent(
+                        FakeBackend(),
+                        "http://127.0.0.1:9999",
+                        "",
+                        str(relative_scratch),
+                    )
+                    session.stream_thread.join(timeout=1)
+            finally:
+                os.chdir(previous_cwd)
+
+            self.assertEqual(
+                captured["backend_working_dir"],
+                str(expected_scratch),
+            )
+            self.assertEqual(
+                captured["popen_working_dir"],
+                str(expected_scratch),
+            )
+
+    def test_expert_local_model_defaults_and_slug_validation(self):
+        self.assertEqual(
+            run_cli._resolve_agent_model(
+                backend="codex",
+                local_agent=True,
+                expert_mode=True,
+                requested=None,
+            ),
