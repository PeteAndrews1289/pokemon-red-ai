+    def test_hall_of_fame_endpoint_uses_verified_completion(self):
+        class FakeMemoryReader:
+            @staticmethod
+            def read_location():
+                return "HallOfFame"
+
+        class FakeEnvironment:
+            memory_reader = FakeMemoryReader()
+
+            def __init__(self, verified):
+                self.verified = verified
+
+            def _champion_hall_of_fame_verified(self):
+                return self.verified
+
+        original_env = server_app.env
+        try:
+            server_app.env = FakeEnvironment(False)
+            incomplete = asyncio.run(
+                server_app.get_termination_condition("hall_of_fame", 1)
+            )
+            self.assertFalse(incomplete["condition_met"])
+
+            server_app.env = FakeEnvironment(True)
+            complete = asyncio.run(
+                server_app.get_termination_condition("hall_of_fame", 1)
+            )
+            self.assertTrue(complete["condition_met"])
+            self.assertEqual(complete["current_location"], "HallOfFame")
+        finally:
+            server_app.env = original_env
