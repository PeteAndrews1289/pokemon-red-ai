+    """Link host Codex login credentials into a run-local CODEX_HOME.
+
+    Local execution keeps the agent's config and session history isolated under
+    the run directory while reusing the host's ChatGPT login without copying the
+    credential file onto the experiment drive.  OpenRouter runs do not need this
+    helper because their key is inherited through the process environment.
+    """
+    host_codex_dir = host_codex_dir or (Path.home() / ".codex")
+    linked_any = False
+
+    for name in ("auth.json", "credentials.json"):
+        source = host_codex_dir / name
+        if not source.is_file():
+            continue
+
+        destination = agent_memory_dir / name
+        if destination.exists():
+            linked_any = True
+            continue
+        if destination.is_symlink():
+            # Replace a broken link from a moved home directory.
+            destination.unlink()
+
+        destination.symlink_to(source)
+        print(f"   ✓ Linked host {name} for local Codex authentication")
+        linked_any = True
+
+    if not linked_any:
+        print("❌ No host Codex login was found in ~/.codex.")
+        print("   Run 'codex login' first, or use --api-gateway openrouter.")
+    return linked_any
