+def test_backup_zip_excludes_credentials_symlinks_sessions_and_secret_content(
+    tmp_path,
+    monkeypatch,
+):
+    cache = tmp_path / "cache" / "run-safe"
+    cache.mkdir(parents=True)
+    (cache / "objectives.json").write_text('{"safe": true}', encoding="utf-8")
+    secret_text = "V11-SHOULD-NEVER-ENTER-AN-ARCHIVE"
+    secret_source = tmp_path / "host-auth-source"
+    secret_source.write_text(secret_text, encoding="utf-8")
+    (cache / "auth.json").symlink_to(secret_source)
+    (cache / "credentials.json").write_text(secret_text, encoding="utf-8")
+    sessions = cache / "codex_memory" / "sessions" / "2026"
+    sessions.mkdir(parents=True)
+    (sessions / "rollout.jsonl").write_text(secret_text, encoding="utf-8")
+
+    fake_manager = SimpleNamespace(run_id="run-safe")
+    monkeypatch.setattr(
+        "utils.data_persistence.run_data_manager.get_run_data_manager",
+        lambda: fake_manager,
+    )
+    archive = backup_manager.create_cache_backup(
+        "termination",
+        "test",
+        cache_dir=str(cache),
+        backup_base_dir=str(tmp_path / "backups"),
+    )
+
+    assert archive is not None
+    with zipfile.ZipFile(archive) as zf:
+        names = zf.namelist()
+        payload = b"".join(zf.read(name) for name in names)
+    assert any(name.endswith("objectives.json") for name in names)
+    assert not any("auth.json" in name or "credentials.json" in name for name in names)
+    assert not any("session" in name.casefold() or "codex_memory" in name for name in names)
+    assert secret_text.encode() not in payload
+
