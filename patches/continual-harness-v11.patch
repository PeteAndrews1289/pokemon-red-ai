+
+def test_champion_requires_rival_victory_event_and_hall_of_fame_map():
+    emulator = RedEmulator.__new__(RedEmulator)
+    emulator.memory_reader = _FakeMemoryReader()
+    emulator.milestone_tracker = _FakeMilestoneTracker()
+    state = {
+        "player": {"location": "ChampionsRoom", "party": []},
+        "game": {"badges": []},
+    }
+
+    event_byte_offset, event_bit_offset = divmod(BEAT_CHAMPION_RIVAL_EVENT_BIT, 8)
+    event_address = EVENT_FLAGS_ADDRESS + event_byte_offset
+
+    # Merely entering the Champion's room was the old false positive.
+    emulator.memory_reader.memory[CURRENT_MAP_ADDRESS] = 0x78
+    assert emulator._check_red_milestone("CHAMPION", state) is False
+
+    # Neither half of the completion condition is sufficient alone.
+    emulator.memory_reader.memory[event_address] = 1 << event_bit_offset
+    assert emulator._check_red_milestone("CHAMPION", state) is False
+    emulator.memory_reader.memory[event_address] = 0
+    emulator.memory_reader.memory[CURRENT_MAP_ADDRESS] = HALL_OF_FAME_MAP_ID
+    assert emulator._check_red_milestone("CHAMPION", state) is False
+
+    emulator.memory_reader.memory[event_address] = 1 << event_bit_offset
+    assert emulator._check_red_milestone("CHAMPION", state) is True
